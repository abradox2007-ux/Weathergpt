# ==========================================
# WeatherGPT Environment Configuration
# ==========================================

# Active LLM Provider (Options: gemini | groq | openai | mock)
LLM_PROVIDER=gemini

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (Get from https://console.groq.com/)
GROQ_API_KEY=

# OpenAI API Key (Get from https://platform.openai.com/)
OPENAI_API_KEY=

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=weathergpt_db

# JWT Secret
JWT_SECRET=weathergpt_sih_hackathon_super_secret_key_2026

# Debug mode
DEBUG=true
